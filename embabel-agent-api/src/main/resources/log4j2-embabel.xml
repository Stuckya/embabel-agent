<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 counterpart of logback-embabel.xml.

    Applied automatically (via logging.config) when the application uses Log4j2 as its
    logging system and supplies no Log4j2 configuration of its own. Keeps Log4j2 applications
    at parity with the Logback default: same console pattern and the same deliberate level
    suppressions. Personality logging is event-driven and framework-agnostic, so it is not
    configured here.
-->
<Configuration>
    <Appenders>
        <!-- %clr and the spring lookup are provided by spring-boot's Log4j2 support -->
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="${spring:logging.pattern.console:-%clr{%d{HH:mm:ss.SSS}}{faint} %clr{[%t]}{magenta} %clr{%-5level} %clr{%logger{1}}{cyan} %clr{-}{faint} %msg%n}"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.springframework.ai.converter.BeanOutputConverter" level="OFF"/>
        <Logger name="com.embabel.agent.core.support.BlackboardWorldStateDeterminer" level="INFO"/>
        <Logger name="com.embabel.agent.api.annotation.support.AgentMetadataReader" level="INFO"/>
        <Logger name="com.embabel.agent.spi.support.LlmRanker" level="INFO"/>
        <Logger name="com.embabel.agent.spi.support.com.embabel.agent.spi.support.springai.ChatClientLlmOperations" level="INFO"/>
        <Logger name="org.jline" level="ERROR"/>
        <Root level="INFO">
            <AppenderRef ref="CONSOLE"/>
        </Root>
    </Loggers>
</Configuration>
